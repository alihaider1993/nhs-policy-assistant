# NHS Employee Policy Assistant
# Author: Syed Ali Haider
# GitHub: github.com/alihaider1993/nhs-policy-assistant
# Built: June 2026 · Redeployed: October 2026
#
# I built this to help NHS staff quickly find answers about their
# employment rights without having to read through 100-page policy PDFs.
# Powered by Azure OpenAI (GPT-4.1 mini) + Azure AI Search (RAG pipeline).
#
# Setup: Copy this file to .env and fill in your Azure credentials
# Security: .env is in .gitignore — never commit real keys to GitHub

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# Found in: portal.azure.com → your Azure OpenAI resource → Keys and Endpoint
# Example: https://aoai-nhs-policy.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://YOUR-FOUNDRY-RESOURCE.openai.azure.com

# Found in: portal.azure.com → your Azure OpenAI resource → Keys and Endpoint → KEY 1
AZURE_OPENAI_KEY=your-azure-openai-key-here

# Chat model deployment name
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# ── Azure AI Search ───────────────────────────────────────────────────────────
# Found in: portal.azure.com → your search service → Overview → Url
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH-SERVICE.search.windows.net

# Found in: portal.azure.com → your search service → Keys → Primary admin key
# (an admin key is required: Azure OpenAI On Your Data reads the index definition)
AZURE_SEARCH_KEY=your-azure-search-key-here

# Index created by ingest.py
AZURE_SEARCH_INDEX=nhs-policy
